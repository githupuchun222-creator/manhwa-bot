[Unit]
Description=@manhwatarjima_bot
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
WorkingDirectory=/opt/manhwa-bot4
EnvironmentFile=/opt/manhwa-bot4/server/bot.env
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/manhwa-bot4/.venv/bin/python runner.py
Restart=always
RestartSec=5
# xotira to'lsa butun serverni emas, faqat botni o'ldirsin
OOMScoreAdjust=500
# asosiy bot: serverdagi boshqa botdan (manhwa-atomic, standart 100) protsessor/diskda ~10x ustun (2026-10-19, egasi so'rovi)
CPUWeight=1000
IOWeight=1000

[Install]
WantedBy=multi-user.target
